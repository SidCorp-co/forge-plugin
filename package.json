{
  "name": "eslint-plugin-code-quality",
  "version": "0.2.0",
  "description": "ESLint rules and configs for maintainable comments and god-file limits",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "code-quality-gate": "./bin/code-quality-gate.mjs"
  },
  "files": [
    "src",
    "bin",
    "claude-plugin",
    ".claude-plugin/marketplace.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "eslint": ">=9 <11"
  },
  "devDependencies": {
    "eslint": "^9.32.0"
  },
  "scripts": {
    "test": "node --test",
    "test:hook": "node --test test/lint-edited-file.test.js",
    "lint": "eslint .",
    "pack:check": "node scripts/check-pack.mjs",
    "plugin:validate": "claude plugin validate --strict . && claude plugin validate --strict claude-plugin"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "comments",
    "god-files",
    "max-lines",
    "code-quality"
  ],
  "license": "MIT",
  "author": "Thanh Nguyen"
}
