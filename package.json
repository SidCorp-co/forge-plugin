{
  "name": "forge-plugin",
  "private": true,
  "type": "module",
  "version": "3.35.49",
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-plugin-code-quality": "file:./packages/code-quality"
  },
  "scripts": {
    "version": "node tools/sync-manifest-version.mjs",
    "lint": "eslint .",
    "lint:code-quality": "code-quality-gate",
    "check:vi-text": "node tools/check-vi-text.mjs",
    "check:vi-goldens": "node tools/diff-python.mjs --goldens",
    "check:vendor": "node plugin/scripts/check-vendor.mjs",
    "check": "node tools/gates.mjs",
    "check:package": "npm --prefix packages/code-quality run lint && npm --prefix packages/code-quality test",
    "test": "node --test \"plugin/test/**/*.test.mjs\"",
    "check:skill-paths": "node plugin/scripts/skill-paths.mjs",
    "check:skill-boundaries": "node plugin/scripts/skill-boundaries.mjs",
    "check:dup": "node plugin/scripts/skill-dup.mjs plugin --only comments --exclude hooks/vendor --exclude test",
    "sync:skills": "node tools/sync-skills.mjs",
    "sync:skills:check": "node tools/sync-skills.mjs --check"
  }
}
