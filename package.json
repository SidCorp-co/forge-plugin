{
  "name": "forge-plugin",
  "private": true,
  "type": "module",
  "version": "3.4.0",
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-plugin-code-quality": "file:../eslint-plugin-code-quality"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:code-quality": "code-quality-gate",
    "check:vi-text": "node tools/check-vi-text.mjs",
    "check:vi-goldens": "node tools/diff-python.mjs --goldens",
    "check:vendor": "node scripts/../plugin/scripts/check-vendor.mjs",
    "check": "npm run lint && npm run check:vi-text && npm run check:vi-goldens && npm run check:vendor"
  }
}
