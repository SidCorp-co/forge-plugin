{
  "name": "eslint-plugin-code-quality",
  "version": "0.13.0",
  "description": "ESLint rules and configs for maintainable comments, god-file limits, and design-token discipline",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "code-quality-gate": "./bin/code-quality-gate.mjs",
    "code-quality-setup": "./bin/code-quality-setup.mjs"
  },
  "files": [
    "src",
    "bin",
    "claude-plugin",
    ".claude-plugin/marketplace.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "eslint": ">=9 <11"
  },
  "devDependencies": {
    "eslint": "^9.32.0"
  },
  "scripts": {
    "version": "node -e \"const f='claude-plugin/.claude-plugin/plugin.json',fs=require('fs'),j=JSON.parse(fs.readFileSync(f));j.version=require('./package.json').version;fs.writeFileSync(f,JSON.stringify(j,null,2)+'\\n')\" && git add claude-plugin/.claude-plugin/plugin.json",
    "test": "node --test",
    "test:hook": "node --test test/cli/lint-edited-file.test.js",
    "lint": "eslint .",
    "pack:check": "node scripts/check-pack.mjs",
    "plugin:validate": "claude plugin validate --strict . && claude plugin validate --strict claude-plugin",
    "setup": "node bin/code-quality-setup.mjs"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "comments",
    "god-files",
    "max-lines",
    "code-quality",
    "design-tokens",
    "contrast",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Thanh Nguyen"
}
